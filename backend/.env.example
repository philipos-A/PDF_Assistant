# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5-5
# Effort for answers: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
MAX_OUTPUT_TOKENS=16000
# Server-side refusal fallback (routes declined requests to another model)
ENABLE_FALLBACKS=true
# Uploads: Claude requests are capped at 32 MB and base64 adds ~33%,
# so ~24 MB of PDF is the practical ceiling. Claude also caps PDFs at 600 pages.
MAX_UPLOAD_MB=24
MAX_PAGES=600
STORAGE_DIR=storage
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
