# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5-5
# Effort for answers: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
MAX_OUTPUT_TOKENS=16000
# Server-side refusal fallback (routes declined requests to another model)
ENABLE_FALLBACKS=true
# Upload each PDF to the Files API once and reference it by id (falls back to base64)
USE_FILES_API=true
# Ask Claude to cite the passages it uses; the UI links them to the PDF
ENABLE_CITATIONS=true
# Uploads: inline base64 (used when the Files API is off) adds ~33%, so 24 MB of PDF
# is ~32 MB per request (Claude allows up to 128 MB). Claude caps PDFs at 600 pages
# (100 on smaller-context models).
MAX_UPLOAD_MB=24
MAX_PAGES=600
# PDFs and library.db (documents + conversations)
STORAGE_DIR=storage
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server address
HOST=127.0.0.1
PORT=8000
# Point at a proxy or mock server instead of api.anthropic.com (optional)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Log level, e.g. info, debug, pdf_assistant_backend=debug
# RUST_LOG=info
